\begin{tikzpicture}

\matrix[MatrixSetup]{
%Row 0
\node [DataIO] (output_opt) {$x, z_1, z_2$};&
&
\node [DataIO] (output_D1) {$a_0^\dagger, a_1^\dagger, a_2^\dagger$};&
\node [DataIO] (output_D2) {$a_0^\dagger, a_1^\dagger$};&
\node [DataIO] (output_F) {$a_0^\dagger, a_1^\dagger, a_3^\dagger$};&
&
&
&
&
\\
%Row 1
\node [Optimization] (opt) {$\textbf{Optimizer}$};&
&
\node [DataInter] (opt-D1) {$x, z_1, z_2$};&
\node [DataInter] (opt-D2) {$z_1, z_2$};&
\node [DataInter] (opt-F) {$x, z_1, z_2$};&
&
&
&
&
\node [DataIO] (right_output_opt) {$x^*, z_1^*, z_2^*$};\\
%Row 2
&
\node [MDA] (solver) {$\textbf{Newton Solver}$};&
\node [DataInter] (solver-D1) {$x, z_1, z_2$};&
\node [DataInter] (solver-D2) {$z_1, z_2$};&
&
&
&
&
&
\\
%Row 3
&
\node [DataInter] (D1-solver) {$\mathcal{R}({y_1^\dagger})$};&
\node [Function] (D1) {$\begin{array}{c}\textbf{Discipline 1} \\ y_1 = z_1^2 a_0^\dagger + z_2 a_1^\dagger + x a_2^\dagger - 0.2 y_2\end{array}$};&
\node [DataInter] (D1-D2) {$y_1^\dagger$};&
\node [DataInter] (D1-F) {$y_1^\dagger$};&
\node [DataInter] (D1-G1) {$y_1^\dagger$};&
&
&
&
\\
%Row 4
&
\node [DataInter] (D2-solver) {$\mathcal{R}({y_2^\dagger})$};&
\node [DataInter] (D2-D1) {$y_2^\dagger$};&
\node [Function] (D2) {$\begin{array}{c}\textbf{Discipline 2} \\ y_2 = \sqrt{y_1} + z_1 a_0^\dagger + z_2 a_1^\dagger\end{array}$};&
\node [DataInter] (D2-F) {$y_2^\dagger$};&
&
\node [DataInter] (D2-G2) {$y_2^\dagger$};&
&
&
\\
%Row 5
&
&
&
&
\node [Function] (F) {$\begin{array}{c}\textbf{Objective} \\ f = x^2 + z_2 a_1^\dagger + y_1/a_3^\dagger + e^{-y_2} a_0^\dagger\end{array}$};&
&
&
\node [DataInter] (F-UQ) {$f^\dagger$};&
&
\\
%Row 6
&
&
&
&
&
\node [Function] (G1) {$\begin{array}{c}\textbf{Constraint 1} \\ g_1 = 8 - y_1\end{array}$};&
&
\node [DataInter] (G1-UQ) {$g_1^\dagger$};&
&
\\
%Row 7
&
&
&
&
&
&
\node [Function] (G2) {$\begin{array}{c}\textbf{Constraint 2} \\ g_2 = y_2 - 12\end{array}$};&
\node [DataInter] (G2-UQ) {$g_2^\dagger$};&
&
\\
%Row 8
\node [DataInter] (UQ-opt) {$f_\mu, g_{1_\mu}, g_{2_\mu}$};&
&
&
&
&
&
&
\node [Function] (UQ) {$\begin{array}{c}\textbf{UQPCE}\end{array}$};&
&
\node [DataIO] (right_output_UQ) {$f_{CI}$};\\
%Row 9
&
&
&
&
&
&
&
&
&
\\
};

% XDSM process chains


\begin{pgfonlayer}{data}
\path
% Horizontal edges
(opt) edge [DataLine] (opt-D1)
(opt) edge [DataLine] (opt-D2)
(D1) edge [DataLine] (D1-solver)
(D2) edge [DataLine] (D2-solver)
(solver) edge [DataLine] (solver-D1)
(solver) edge [DataLine] (solver-D2)
(D1) edge [DataLine] (D1-D2)
(D2) edge [DataLine] (D2-D1)
(D1) edge [DataLine] (D1-F)
(D2) edge [DataLine] (D2-F)
(D1) edge [DataLine] (D1-G1)
(D2) edge [DataLine] (D2-G2)
(opt) edge [DataLine] (opt-F)
(F) edge [DataLine] (F-UQ)
(G1) edge [DataLine] (G1-UQ)
(G2) edge [DataLine] (G2-UQ)
(UQ) edge [DataLine] (UQ-opt)
(opt) edge [DataLine] (right_output_opt)
(UQ) edge [DataLine] (right_output_UQ)
% Vertical edges
(opt-D1) edge [DataLine] (D1)
(opt-D2) edge [DataLine] (D2)
(D1-solver) edge [DataLine] (solver)
(D2-solver) edge [DataLine] (solver)
(solver-D1) edge [DataLine] (D1)
(solver-D2) edge [DataLine] (D2)
(D1-D2) edge [DataLine] (D2)
(D2-D1) edge [DataLine] (D1)
(D1-F) edge [DataLine] (F)
(D2-F) edge [DataLine] (F)
(D1-G1) edge [DataLine] (G1)
(D2-G2) edge [DataLine] (G2)
(opt-F) edge [DataLine] (F)
(F-UQ) edge [DataLine] (UQ)
(G1-UQ) edge [DataLine] (UQ)
(G2-UQ) edge [DataLine] (UQ)
(UQ-opt) edge [DataLine] (opt)
(opt) edge [DataLine] (output_opt)
(D1) edge [DataLine] (output_D1)
(D2) edge [DataLine] (output_D2)
(F) edge [DataLine] (output_F);
\end{pgfonlayer}

\end{tikzpicture}
